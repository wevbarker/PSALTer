Notebook[{

Cell[CellGroupData[{
Cell["Examples", "Title",
 CellChangeTimes->{{3.9579536591789103`*^9, 
  3.957953660126248*^9}},ExpressionUUID->"7f56dae8-98e1-4832-8941-\
449b5bc3b176"],

Cell["First we load the package:", "Text",
 CellChangeTimes->{{3.957953673956202*^9, 3.9579536793135433`*^9}, 
   3.9579537788263273`*^9},ExpressionUUID->"cfcba61a-7d56-45b5-9222-\
0ca969faf830"],

Cell[BoxData[
 RowBox[{"<<", "xAct`PSALTer`"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.957953700165028*^9, 
  3.957953700165078*^9}},ExpressionUUID->"bc8f3ee7-e515-4f03-a6ef-\
5976024d3bdb"],

Cell["Next we define two Lagrangian coupling coefficients:", "Text",
 CellChangeTimes->{{3.9579537631008797`*^9, 
  3.957953787657426*^9}},ExpressionUUID->"842d545e-6fdc-4043-826c-\
6f3b0ba3ff72"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefConstantSymbol", "[", 
   RowBox[{"Coupling1", ",", 
    RowBox[{"PrintAs", "->", "\"\<\[Alpha]\>\""}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefConstantSymbol", "[", 
   RowBox[{"Coupling2", ",", 
    RowBox[{"PrintAs", "->", "\"\<\[Beta]\>\""}]}], "]"}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.957953739091133*^9, 
  3.957953740509153*^9}},ExpressionUUID->"7c012896-8f06-49a4-9c79-\
78f8c155f235"],

Cell["Next we define the metric perturbation:", "Text",
 CellChangeTimes->{{3.9579538340889187`*^9, 3.957953834944775*^9}, {
  3.9579538846470337`*^9, 
  3.957953897649444*^9}},ExpressionUUID->"c4664b6a-efaf-4cd3-9c23-\
3a650f3e9941"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DefField", "[", 
   RowBox[{
    RowBox[{"MetricPerturbation", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", " ", 
      RowBox[{"-", "b"}]}], "]"}], ",", " ", 
    RowBox[{"Symmetric", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "a"}], ",", " ", 
       RowBox[{"-", "b"}]}], "}"}], "]"}], ",", " ", 
    RowBox[{"PrintAs", " ", "->", " ", "\"\<\[ScriptH]\>\""}], ",", " ", 
    RowBox[{"PrintSourceAs", " ", "->", " ", "\"\<\[ScriptCapitalT]\>\""}]}], 
   "]"}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.957953815516354*^9, 3.957953817102384*^9}, {
  3.9579539136013927`*^9, 
  3.957953921869733*^9}},ExpressionUUID->"0b24ebe8-53cb-4f8c-9834-\
fb657e96b4f7"],

Cell["Next we compute the spectrograph of massive gravity:", "Text",
 CellChangeTimes->{{3.957953930188555*^9, 
  3.9579539546046267`*^9}},ExpressionUUID->"bbf952a3-bddf-40c4-9682-\
289bf533bd98"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ParticleSpectrum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Coupling1", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}], "*", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "b"}], "]"}], "@", 
          RowBox[{"MetricPerturbation", "[", 
           RowBox[{"a", ",", 
            RowBox[{"-", "a"}]}], "]"}]}], "*", 
         RowBox[{
          RowBox[{"CD", "[", "b", "]"}], "@", 
          RowBox[{"MetricPerturbation", "[", 
           RowBox[{"c", ",", 
            RowBox[{"-", "c"}]}], "]"}]}]}], "-", 
        RowBox[{
         RowBox[{
          RowBox[{"CD", "[", "a", "]"}], "@", 
          RowBox[{"MetricPerturbation", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", 
            RowBox[{"-", "b"}]}], "]"}]}], "*", 
         RowBox[{
          RowBox[{"CD", "[", "b", "]"}], "@", 
          RowBox[{"MetricPerturbation", "[", 
           RowBox[{"c", ",", 
            RowBox[{"-", "c"}]}], "]"}]}]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}], "*", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "c"}], "]"}], "@", 
          RowBox[{"MetricPerturbation", "[", 
           RowBox[{"a", ",", "b"}], "]"}]}], "*", 
         RowBox[{
          RowBox[{"CD", "[", "c", "]"}], "@", 
          RowBox[{"MetricPerturbation", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", 
            RowBox[{"-", "b"}]}], "]"}]}]}], "+", 
        RowBox[{
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "b"}], "]"}], "@", 
          RowBox[{"MetricPerturbation", "[", 
           RowBox[{"a", ",", "b"}], "]"}]}], "*", 
         RowBox[{
          RowBox[{"CD", "[", "c", "]"}], "@", 
          RowBox[{"MetricPerturbation", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", 
            RowBox[{"-", "c"}]}], "]"}]}]}]}], ")"}]}], "+", 
     RowBox[{"Coupling2", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"MetricPerturbation", "[", 
          RowBox[{
           RowBox[{"-", "a"}], ",", 
           RowBox[{"-", "b"}]}], "]"}], "*", 
         RowBox[{"MetricPerturbation", "[", 
          RowBox[{"a", ",", "b"}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"MetricPerturbation", "[", 
          RowBox[{"a", ",", 
           RowBox[{"-", "a"}]}], "]"}], "*", 
         RowBox[{"MetricPerturbation", "[", 
          RowBox[{"b", ",", 
           RowBox[{"-", "b"}]}], "]"}]}]}], ")"}]}]}], ",", 
    RowBox[{"TheoryName", "->", "\"\<MassiveGravity\>\""}], ",", 
    RowBox[{"MaxLaurentDepth", "->", "3"}]}], "]"}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9579539629909153`*^9, 
  3.957953964278137*^9}},ExpressionUUID->"bccc0b25-d95f-4675-b601-\
9b4cc3498f47"]
}, Open  ]]
},
